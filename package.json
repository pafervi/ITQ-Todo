{
  "name": "LatticeTodo",
  "version": "3.0.3",
  "private": true,
  "description": "Personal planner and lab notebook for computational catalysis research.",
  "author": "Pau Ferri-Vicedo <pauferrivi@gmail.com>",
  "homepage": "https://github.com/pafervi/LatticeTodo",
  "keywords": [
    "ToDo",
    "Weekly Planner",
    "to-do",
    "Productivity",
    "Minimalist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue,.mjs src electron",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "release": "electron-builder",
    "test": "echo success",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "main": "dist-electron/main.js",
  "repository": "https://github.com/pafervi/LatticeTodo",
  "dependencies": {
    "@achrinza/node-ipc": "^10.1.10",
    "@manuelernestog/click-handler": "^1.4.0",
    "@popperjs/core": "^2.11.0",
    "auto-launch": "^5.0.5",
    "axios": "^1.4.0",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.5",
    "core-js": "^3.20.1",
    "electron-config": "^2.0.0",
    "is-electron": "^2.2.1",
    "linkify-string": "^3.0.4",
    "linkifyjs": "^3.0.5",
    "lodash.uniqueid": "^4.0.1",
    "markdown-it": "^13.0.1",
    "moment": "^2.29.1",
    "rrule": "^2.6.9",
    "vue": "^3.2.26",
    "vue-i18n": "^9.1.9",
    "vue3-datepicker": "^0.2.5",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.9",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/compiler-sfc": "^3.2.26",
    "electron": "^25.0.1",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.28.0",
    "sass": "^1.69.5",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "latticetodo.local",
    "productName": "LatticeTodo",
    "publish": null,
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "category": "Office;ProjectManagement",
      "description": "Personal planner and lab notebook for computational catalysis research.",
      "synopsis": "Personal planner for computational research",
      "executableName": "latticetodo",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/linux-icons"
    },
    "deb": {
      "packageName": "latticetodo",
      "artifactName": "latticetodo_${version}_amd64.deb"
    },
    "appImage": {
      "artifactName": "LatticeTodo-${version}.AppImage"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "pkg"
      ]
    }
  }
}
